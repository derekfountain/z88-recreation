	(gr_text "Note how this connector is arranged relative to the one on the main board.\nThey are facing each other, so pin 1 on the main board (GND) is on the right\nside, and that matches up with pin 40 on this board. So pin 40 on this side\nis GND. The sequence of pins is essentially inverted so a straight cable\ntakes the signals out of one connector into the other."
		(at 198.25 150.5 0)
		(layer "Cmts.User")
		(uuid "7d9eb7c1-aa9c-4bd4-8a98-f10af3c760cf")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
