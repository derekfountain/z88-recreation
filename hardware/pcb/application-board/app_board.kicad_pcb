	(gr_text "Z88 Recreation Application Board v1.1 https://github.com/derekfountain/z88-recreation"
		(at 252.05 154.1 0)
		(layer "F.SilkS")
		(uuid "825780a8-355d-47ce-a16b-31c1358f460e")
		(effects
