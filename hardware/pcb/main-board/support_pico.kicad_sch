	(text "SD card for Z88 file system, cartridge images, etc.\nAlso for the application board Pico's note taking\napps (etc.)\n\nCM4 accesses this via the support RP2040."
		(exclude_from_sim no)
		(at 180.34 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0d16ee6d-a081-4b58-91ab-9b3ab537a6ae")
	)
	(text "Software link to App Board Pico1"
		(exclude_from_sim no)
		(at 138.43 87.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1787d750-6f55-42a6-9fab-7aa726b6db1a")
	)
	(text "The design is that the CM4 is the I2C bus master. The\nSupport RP2040 will only be bus master when the I2C is\noff, and since the Support RP2040 turns on the CM4 it's\nsafe to set them both up as bus masters. They can't\nclash, even if the I2C drivers don't support multi master."
		(exclude_from_sim no)
		(at 13.97 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "489f26b0-b40a-45e5-94ca-4eac63dc8218")
	)
	(text "Enabled by RP2040. Don't bother with the\nBOOTSEL switch unless there's a problem."
		(exclude_from_sim no)
		(at 181.61 99.06 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "87b09d69-5a68-4e0f-a7e3-947fa819c6d4")
	)
	(text "Make sure C1208\nis close to\npin 45 of RP2040"
		(exclude_from_sim no)
		(at 16.51 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "888adf94-2639-46e7-b12f-1ba2d09d7546")
	)
	(text "Make sure C10 is close to pin 44 of RP2040"
		(exclude_from_sim no)
		(at 99.06 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f83fe62-0866-47f2-9bbc-071e822f6f54")
	)
	(text "UART1 to App Board Pico0"
