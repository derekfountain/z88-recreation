	(text "Switched 3V3 comes from a 3V3 regulator.\nSee the Power page."
		(exclude_from_sim no)
		(at 57.15 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d1dfba87-3473-4f13-ac09-929dea0678de")
	)
	(text "The keyboard RP2040 is always needed when this one is on,\nso the two RP2040s will use the same power source.\n\nThis RP2040 will be programmed with knowledge about the side\ndisplays (whether they exist, for a start). If the side displays\nPCB is connected, this RP2040 will send the signal to start it up."
		(exclude_from_sim no)
		(at 13.97 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d7e40fb9-a365-4475-be42-30ca476087ec")
	)
	(text "UART0 to CM4"
		(exclude_from_sim no)
		(at 138.43 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "da4efab6-d87b-4cfc-b3b9-e680967c5cdc")
	)
	(text "Flash, 16MB should be enough\nfor anything this RP2040 might do"
